{
  "name": "@uswap/frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"pnpm --filter @uswap/backend dev\" \"pnpm --filter @uswap/frontend dev\"",
    "build": "pnpm --filter @uswap/backend build && pnpm --filter @uswap/frontend build",
    "start": "pnpm --filter @uswap/backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.0.0"
}
