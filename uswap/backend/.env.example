# ── ChangeNOW API ──────────────────────────────────────────────────────────
# Get yours at https://changenow.io/api
CHANGENOW_API_KEY=

# Register at https://changenow.io/affiliate — this is what earns you the
# affiliate commission on every swap. Leave empty to disable (you earn 0%).
CHANGENOW_AFFILIATE_ID=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001

# 'production' enables stricter CORS and disables the localhost fallback.
NODE_ENV=production

# Comma-separated list of allowed frontend origins. REQUIRED in production.
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# ── Database ───────────────────────────────────────────────────────────────
# SQLite file path. Created automatically on first run. Back this file up.
DATABASE_PATH=./data/uswap.db
